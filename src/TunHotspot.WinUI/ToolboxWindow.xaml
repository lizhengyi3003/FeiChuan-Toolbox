<Window x:Class="TunHotspot.ToolboxWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:automation="using:Microsoft.UI.Xaml.Automation"
 Title="TUN 热点与启动工具箱">
 <Window.SystemBackdrop><MicaBackdrop/></Window.SystemBackdrop>
 <Grid x:Name="ShellRoot" Background="Transparent">
  <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid x:Name="TitleArea" Background="Transparent" Padding="18,0,130,0">
   <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
    <Image Source="Assets/TunHotspot.png" Width="22" Height="22"/>
    <TextBlock Text="TUN 热点与启动工具箱" FontSize="13"/>
    <TextBlock x:Name="VersionLabel" Text="启动管理" FontSize="12" Opacity="0.6"/>
   </StackPanel>
  </Grid>
  <Grid Grid.Row="1" Padding="22,10,22,14" RowSpacing="8" ColumnSpacing="12">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel Spacing="3"><TextBlock x:Name="ScanTitle" Text="准备扫描" FontWeight="SemiBold"/>
    <TextBlock x:Name="ScanDescription" Text="配置入口、实际运行与建议分别核对。" FontSize="12" TextWrapping="Wrap" Opacity="0.7"/></StackPanel>
   <Button x:Name="GlobalScanButton" Grid.Column="1" Click="GlobalScan_Click" Style="{ThemeResource AccentButtonStyle}" automation:AutomationProperties.AutomationId="GlobalScan" automation:AutomationProperties.Name="全局扫描（管理员）">
    <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE83D;" FontFamily="Segoe Fluent Icons" FontSize="16"/><TextBlock Text="全局扫描（管理员）"/></StackPanel>
   </Button>
   <Button x:Name="CancelScanButton" Grid.Column="2" Content="取消" Click="CancelScan_Click" IsEnabled="False"/>
   <ProgressBar x:Name="ScanProgressBar" Grid.Row="1" Grid.ColumnSpan="3" Minimum="0" Maximum="100" Height="4" IsIndeterminate="True" automation:AutomationProperties.AutomationId="ScanProgress"/>
  </Grid>
  <NavigationView x:Name="Navigation" Grid.Row="2" IsBackButtonVisible="Collapsed" IsSettingsVisible="False"
      PaneDisplayMode="Auto" OpenPaneLength="210" IsPaneOpen="True" SelectionChanged="Navigation_SelectionChanged">
   <NavigationView.MenuItems>
    <NavigationViewItem Content="总览" Tag="overview"><NavigationViewItem.Icon><FontIcon Glyph="&#xE80F;" FontFamily="Segoe Fluent Icons"/></NavigationViewItem.Icon></NavigationViewItem>
    <NavigationViewItem Content="分类浏览" Tag="groups"><NavigationViewItem.Icon><FontIcon Glyph="&#xE8F1;" FontFamily="Segoe Fluent Icons"/></NavigationViewItem.Icon></NavigationViewItem>
    <NavigationViewItem Content="按应用查看" Tag="apps"><NavigationViewItem.Icon><FontIcon Glyph="&#xE71D;" FontFamily="Segoe Fluent Icons"/></NavigationViewItem.Icon></NavigationViewItem>
    <NavigationViewItem Content="全部启动入口" Tag="entries"><NavigationViewItem.Icon><FontIcon Glyph="&#xE8FD;" FontFamily="Segoe Fluent Icons"/></NavigationViewItem.Icon></NavigationViewItem>
    <NavigationViewItem Content="Codex 创建" Tag="codex-origin"><NavigationViewItem.Icon><FontIcon Glyph="&#xE943;" FontFamily="Segoe Fluent Icons"/></NavigationViewItem.Icon></NavigationViewItem>
    <NavigationViewItem Content="DSH 创建" Tag="dsh-origin"><NavigationViewItem.Icon><FontIcon Glyph="&#xE943;" FontFamily="Segoe Fluent Icons"/></NavigationViewItem.Icon></NavigationViewItem>
    <NavigationViewItem Content="运行与拉起记录" Tag="runtime"><NavigationViewItem.Icon><FontIcon Glyph="&#xE9D9;" FontFamily="Segoe Fluent Icons"/></NavigationViewItem.Icon></NavigationViewItem>
    <NavigationViewItem Content="Codex 待分析" Tag="pending"><NavigationViewItem.Icon><FontIcon Glyph="&#xE8BD;" FontFamily="Segoe Fluent Icons"/></NavigationViewItem.Icon></NavigationViewItem>
    <NavigationViewItem Content="通知与关注" Tag="alerts"><NavigationViewItem.Icon><FontIcon Glyph="&#xE7F4;" FontFamily="Segoe Fluent Icons"/></NavigationViewItem.Icon></NavigationViewItem>
    <NavigationViewItem Content="快照与变化" Tag="changes"><NavigationViewItem.Icon><FontIcon Glyph="&#xE81C;" FontFamily="Segoe Fluent Icons"/></NavigationViewItem.Icon></NavigationViewItem>
    <NavigationViewItem Content="操作与恢复" Tag="controls"><NavigationViewItem.Icon><FontIcon Glyph="&#xE7A7;" FontFamily="Segoe Fluent Icons"/></NavigationViewItem.Icon></NavigationViewItem>
    <NavigationViewItemSeparator/>
    <NavigationViewItem Content="兼容热点" Tag="hotspot"><NavigationViewItem.Icon><FontIcon Glyph="&#xE701;" FontFamily="Segoe Fluent Icons"/></NavigationViewItem.Icon></NavigationViewItem>
   </NavigationView.MenuItems>
   <NavigationView.FooterMenuItems><NavigationViewItem Content="设置" Tag="settings"><NavigationViewItem.Icon><FontIcon Glyph="&#xE713;" FontFamily="Segoe Fluent Icons"/></NavigationViewItem.Icon></NavigationViewItem></NavigationView.FooterMenuItems>
   <ContentControl x:Name="PageHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Padding="20,6,24,18"/>
  </NavigationView>
  <InfoBar x:Name="Message" Grid.Row="3" IsOpen="False" IsClosable="True" Margin="18,0,18,12"/>
 </Grid>
</Window>
