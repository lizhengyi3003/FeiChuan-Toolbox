<UserControl x:Class="TunHotspot.HotspotPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="using:Microsoft.UI.Xaml.Automation">
  <Grid x:Name="Root" Padding="28,16,28,24" RowSpacing="22">
    <Grid.RowDefinitions>
      <RowDefinition Height="36"/><RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <Grid x:Name="TitleArea" Background="Transparent">
      <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <Image Source="Assets/TunHotspot.png" Width="22" Height="22" automation:AutomationProperties.AccessibilityView="Raw" />
        <TextBlock Text="TUN 热点助手" Style="{ThemeResource CaptionTextBlockStyle}"/>
      </StackPanel>
    </Grid>
    <StackPanel Grid.Row="1" Spacing="8">
      <TextBlock Text="共享连接，轻松一点。" Style="{ThemeResource TitleTextBlockStyle}" TextWrapping="Wrap"/>
      <TextBlock Text="通过 Kumiryo 的 TUN 共享电脑热点。" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
    </StackPanel>
    <Border Grid.Row="2" Padding="22" CornerRadius="12" BorderThickness="1"
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
      <Grid RowSpacing="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Spacing="16">
          <Border Width="52" Height="52" CornerRadius="14" Background="{ThemeResource AccentFillColorDefaultBrush}">
            <FontIcon Glyph="&#xE701;" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" FontSize="25"/>
          </Border>
          <StackPanel VerticalAlignment="Center" Spacing="4">
            <TextBlock x:Name="StatusText" Text="正在读取热点状态…" FontSize="21" FontWeight="SemiBold"
                automation:AutomationProperties.AutomationId="HotspotStatus" automation:AutomationProperties.LiveSetting="Polite"/>
            <TextBlock x:Name="StatusDescription" Text="请稍等" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
          </StackPanel>
        </StackPanel>
        <Border Grid.Row="1" Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>
        <Grid Grid.Row="2" ColumnSpacing="24">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <StackPanel Spacing="6">
            <TextBlock Text="TUN 连接" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <TextBlock x:Name="TunText" Text="正在检测" FontWeight="SemiBold" automation:AutomationProperties.AutomationId="TunState"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Spacing="6">
            <TextBlock Text="连接设备" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <TextBlock x:Name="ClientsText" Text="—" FontWeight="SemiBold" automation:AutomationProperties.AutomationId="ClientCount"/>
          </StackPanel>
        </Grid>
      </Grid>
    </Border>
    <Grid Grid.Row="3" ColumnSpacing="12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Button x:Name="StartButton" Content="开启兼容热点" Height="48" HorizontalAlignment="Stretch"
          Style="{ThemeResource AccentButtonStyle}" Click="Start_Click" IsEnabled="False"
          automation:AutomationProperties.AutomationId="StartHotspot"/>
      <Button x:Name="StopButton" Grid.Column="1" Content="关闭热点" Height="48" HorizontalAlignment="Stretch"
          Click="Stop_Click" IsEnabled="False" automation:AutomationProperties.AutomationId="StopHotspot"/>
    </Grid>
    <InfoBar x:Name="MessageBar" Grid.Row="4" IsOpen="False" IsClosable="True" Severity="Error"/>
    <TextBlock Grid.Row="5" VerticalAlignment="Bottom" TextWrapping="Wrap" FontSize="12"
        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
        Text="由你手动开关热点。关闭窗口会保持当前热点状态。"/>
  </Grid>
</UserControl>
